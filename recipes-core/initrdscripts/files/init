#!/bin/sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin

ROOT_MOUNT="/rootfs/"

. /lib/opensolo/maintenance.sh

BOOT_DISK="/dev/mmcblk0"
BOOT_PART_PREFIX="p"

part_dev() {
	echo "${BOOT_DISK}${BOOT_PART_PREFIX}$1"
}

set_boot_disk_from_root() {
	case "$ROOT_DEVICE" in
		/dev/mmcblk[0-9]*p[0-9]*)
			BOOT_DISK="${ROOT_DEVICE%p*}"
			BOOT_PART_PREFIX="p"
			;;
		/dev/mmcblk[0-9]*)
			BOOT_DISK="$ROOT_DEVICE"
			BOOT_PART_PREFIX="p"
			;;
		/dev/sd[a-z][0-9]*)
			BOOT_DISK="${ROOT_DEVICE%%[0-9]*}"
			BOOT_PART_PREFIX=""
			;;
		/dev/sd[a-z])
			BOOT_DISK="$ROOT_DEVICE"
			BOOT_PART_PREFIX=""
			;;
		/dev/nvme*n[0-9]p[0-9]*)
			BOOT_DISK="${ROOT_DEVICE%p*}"
			BOOT_PART_PREFIX="p"
			;;
	esac
}

# Copied from initramfs-framework. The core of this script probably should be
# turned into initramfs-framework modules to reduce duplication.
udev_daemon() {
	OPTIONS="/sbin/udev/udevd /sbin/udevd /lib/udev/udevd /lib/systemd/systemd-udevd"

	for o in $OPTIONS; do
		if [ -x "$o" ]; then
			echo $o
			return 0
		fi
	done

	return 1
}

_UDEV_DAEMON=`udev_daemon`

mmc_sector_size() {
	DISK_NAME="${BOOT_DISK##*/}"
	SECTOR_SIZE=`cat "/sys/block/${DISK_NAME}/queue/logical_block_size" 2>/dev/null`
	[ -z "$SECTOR_SIZE" ] && SECTOR_SIZE=512
	echo "$SECTOR_SIZE"
}

part_info() {
	PART_NUM="$1"
	parted -sm -- "$BOOT_DISK" unit s print 2>/dev/null | awk -F: -v p="$PART_NUM" '$1==p {print}'
}

part_end_sector() {
	part_info "$1" | awk -F: '{gsub("s","",$3); print $3}'
}

part_size_sectors() {
	part_info "$1" | awk -F: '{gsub("s","",$4); print $4}'
}

wait_for_part() {
	PART_NUM="$1"
	i=0
	while [ $i -lt 50 ]; do
		[ -b "$(part_dev "$PART_NUM")" ] && return 0
		usleep 100000 2>/dev/null || sleep 0.1
		i=$((i + 1))
	done
	return 1
}

early_setup() {
    mkdir -p /proc
    mkdir -p /sys
    mkdir -p /dev
    mount -t proc proc /proc
    mount -t sysfs sysfs /sys
    mount -t devtmpfs none /dev
#    mknod -m 600 /dev/initctl p

    # support modular kernel
    modprobe isofs 2> /dev/null

    mkdir -p /run
    mkdir -p /var/run

    #$_UDEV_DAEMON --daemon
    #udevadm trigger --action=add
}

read_args() {
    [ -z "$CMDLINE" ] && CMDLINE=`cat /proc/cmdline`
    for arg in $CMDLINE; do
        optarg=`expr "x$arg" : 'x[^=]*=\(.*\)'`
        case $arg in
            root=*)
                ROOT_DEVICE=$optarg ;;
            factoryreset=*)
                FORCE_FACTORY_RESET=$optarg;;
        esac
    done
}

boot_live_root() {
    # Watches the udev event queue, and exits if all current events are handled
    #udevadm settle --timeout=3 --quiet
    #killall "${_UDEV_DAEMON##*/}" 2>/dev/null

    mount -n --move /proc ${ROOT_MOUNT}/proc
    mount -n --move /sys ${ROOT_MOUNT}/sys
    mount -n --move /dev ${ROOT_MOUNT}/dev

    echo "Switching root"
    cd "$ROOT_MOUNT" || fatal "Failed to chdir to new root ($ROOT_MOUNT)"

    # IMPORTANT: /init is PID 1. Use exec so /sbin/init becomes PID 1.
    # Use util-linux switch_root semantics (no BusyBox-only -c flag).
    exec switch_root "$ROOT_MOUNT" /sbin/init
    fatal "switch_root failed"
}

fatal() {
    msg="$1"

    for c in "$CONSOLE" "${ROOT_MOUNT}/dev/console" "/dev/console" "/dev/kmsg"; do
        [ -n "$c" ] || continue
        if echo "$msg" >"$c" 2>/dev/null; then
            echo >"$c" 2>/dev/null || true
            break
        fi
    done

    if command -v sh >/dev/null 2>&1; then
        exec sh
    elif [ -x /bin/sh ]; then
        exec /bin/sh
    elif [ -x /bin/busybox ]; then
        exec /bin/busybox sh
    fi

    exec /bin/bash
}

seed_latest_from_golden()
{
    echo "Seeding LATEST from GOLDEN"

    mkdir -p "$GOLDEN_MOUNT" "$LATEST_MOUNT" || fatal "Cannot create seed mountpoints"

    if ! grep -q " ${GOLDEN_MOUNT} " /proc/mounts 2>/dev/null; then
        mount -o ro "$(part_dev 1)" "$GOLDEN_MOUNT" || fatal "Failed to mount GOLDEN"
    fi

    if ! grep -q " ${LATEST_MOUNT} " /proc/mounts 2>/dev/null; then
        mount "$(part_dev 2)" "$LATEST_MOUNT" || fatal "Failed to mount LATEST"
    fi

    # Copy boot files, excluding the GOLDEN-only transaction record, so U-Boot can boot
    # from LATEST on the next reboot.
    #
    # NOTE: BusyBox ash does not enable pipefail by default, so a tar|tar pipeline
    # can succeed even if the first tar fails. Copy and compare each required file.
    find "$LATEST_MOUNT" -mindepth 1 -maxdepth 1 -exec rm -rf {} + || fatal "Cannot clear LATEST for seeding"
    # NOTE: Avoid cp -a/-p here. vfat doesn't support Unix ownership/permissions
    # and some cp implementations return non-zero when they can't preserve them,
    # which can abort seeding and leave p2 empty.
    for seed_file in "$GOLDEN_MOUNT"/* "$GOLDEN_MOUNT"/.[!.]* "$GOLDEN_MOUNT"/..?*; do
        [ -e "$seed_file" ] || continue
        case "${seed_file##*/}" in .opensolo-provisioning|.opensolo-provisioning.new) continue ;; esac
        cp -R "$seed_file" "$LATEST_MOUNT/" || fatal "Failed to copy GOLDEN -> LATEST"
    done
    for seed_file in $PAYLOAD_FILES; do
        [ -s "${LATEST_MOUNT}/$seed_file" ] || fatal "LATEST seed failed: missing $seed_file"
        cmp -s "${GOLDEN_MOUNT}/$seed_file" "${LATEST_MOUNT}/$seed_file" || fatal "LATEST seed verification failed: $seed_file"
    done

    echo "LATEST seeded:"
    ls -la "$LATEST_MOUNT" 2>/dev/null || true

    sync || fatal "Cannot sync LATEST seed"
    umount "$LATEST_MOUNT" || fatal "Cannot unmount LATEST seed"
    umount "$GOLDEN_MOUNT" || fatal "Cannot unmount GOLDEN seed"
}

latest_has_boot_payload()
{
    mkdir -p "$LATEST_CHECK_MOUNT" || fatal "Cannot create LATEST check mountpoint"
    if ! mount -o ro "$(part_dev 2)" "$LATEST_CHECK_MOUNT" 2>/dev/null; then
        rmdir "$LATEST_CHECK_MOUNT" 2>/dev/null || true
        return 1
    fi

    ok=0
    for check_file in $PAYLOAD_FILES; do
        [ -s "$LATEST_CHECK_MOUNT/$check_file" ] || ok=1
    done
    umount "$LATEST_CHECK_MOUNT" || fatal "Cannot release LATEST payload check"
    rmdir "$LATEST_CHECK_MOUNT" 2>/dev/null || true
    return $ok
}

setScreenUpdating() {
    #Set up the Artoo serial port, send a slip-encoded message
    #indicating that we've started the update.
    stty -F /dev/ttymxc1 115200 cs8 -cstopb -parity -crtscts
    echo -en "\xC0\x12\x00\xC0" > /dev/ttymxc1
}

setLedUpdating() {
    #Blink the LED crazy fast
    echo timer >> /sys/class/leds/user2/trigger
    echo 50 >> /sys/class/leds/user2/delay_on
    echo 50 >> /sys/class/leds/user2/delay_off
}

setLedDone() {
    echo none >> /sys/class/leds/user2/trigger
}

checkRwfs() {
    fsck.ext3 -p "$(part_dev 3)"
    fsck_result=$?
    [ "$fsck_result" -le 1 ] || fatal "RWFS needs recovery; preserving settings"
}

checkLog() {
    fsck.ext3 -p "$(part_dev 4)"
    fsck_result=$?
    [ "$fsck_result" -le 1 ] || fatal "LOG needs recovery; preserving update state"
}

mount_and_boot() {
    mkdir -p "$ROOT_MOUNT"
    mknod /dev/loop0 b 7 0 2>/dev/null
    mkdir -p /mnt/ro_rootfs
    mkdir -p /mnt/rw_rootfs
    mkdir -p /mnt/boot
    
    #Check the boot partitions
    fsck.vfat -y "$(part_dev 1)"
    if [ $? -ge 4 ]; then
        echo "Error detected on GOLDEN partition"
    fi
    fsck.vfat -y "$(part_dev 2)"
    if [ $? -ge 4 ]; then
        echo "Error detected on LATEST partition"
    fi

    #Mount the boot partition
    echo "Using $ROOT_DEVICE as the boot partition"
    mount -o ro "$ROOT_DEVICE" /mnt/boot || fatal "Cannot mount boot partition"

    #Mount the read-only squashfs partition
    mount -o ro "/mnt/boot/$PAYLOAD_ROOTFS" /mnt/ro_rootfs || fatal "Cannot mount root filesystem"
    
    #Check the rw partition after explicit reset handling
    filesystem_matches 3 ext3 RWFS || fatal "Invalid RWFS filesystem"
    checkRwfs

    #mount the read-write partition
    mount "$(part_dev 3)" /mnt/rw_rootfs || fatal "Cannot mount RWFS"

    #Mount the overlayfs union partition (replacing legacy AUFS)
    modprobe overlay 2>/dev/null || true
    mkdir -p /mnt/rw_rootfs/upper
    rm -rf /mnt/rw_rootfs/work
    mkdir -p /mnt/rw_rootfs/work
    mount -t overlay overlay \
        -o lowerdir=/mnt/ro_rootfs,upperdir=/mnt/rw_rootfs/upper,workdir=/mnt/rw_rootfs/work \
        "$ROOT_MOUNT" || fatal "Cannot mount root overlay"

    #Move all those mount points
    mkdir -p $ROOT_MOUNT/mnt/rootfs.ro $ROOT_MOUNT/mnt/rootfs.rw $ROOT_MOUNT/mnt/boot
    mount --move /mnt/boot $ROOT_MOUNT/mnt/boot || fatal "Cannot move boot mount"
    mount --move /mnt/ro_rootfs $ROOT_MOUNT/mnt/rootfs.ro || fatal "Cannot move rootfs mount"
    mount --move /mnt/rw_rootfs $ROOT_MOUNT/mnt/rootfs.rw || fatal "Cannot move RWFS mount"

    # boot the image
    boot_live_root
}

resume_provisioning() {
    provision_partitions
    if [ "$PROVISION_MODE" != settings ]; then
        seed_latest_from_golden
    fi
    if [ "$PROVISION_MODE" = reset ]; then
        mkdir -p "$GOLDEN_MOUNT" || fatal "Cannot create GOLDEN mountpoint"
        mount -o ro "$(part_dev 1)" "$GOLDEN_MOUNT" || fatal "Cannot mount factory bootloader"
        flash_bootloader "$GOLDEN_MOUNT/u-boot.imx" /tmp/factory-bootloader.readback \
            || fatal "Factory bootloader failed: $UPDATE_ERROR"
        umount "$GOLDEN_MOUNT" || fatal "Cannot release factory bootloader"
    fi
    clear_provision_state
}

reboot_after_maintenance() {
    setLedDone
    sync || fatal "Cannot sync before reboot"
    /sbin/shutdown -r -n now || fatal "Cannot request reboot"
    fatal "Reboot requested; waiting for system restart"
}

factory_reset() {
    setScreenUpdating
    setLedUpdating
    begin_provisioning reset
    resume_provisioning
    reboot_after_maintenance
}

echo "******************** INITRD ********************"
early_setup
SOLO_MACHINE=$(cat /etc/opensolo-machine) || fatal "Cannot read initramfs machine"
set_machine_payload
read_args
set_boot_disk_from_root
[ -z "$CONSOLE" ] && CONSOLE="/dev/console"

# Inspect durable state before normal partition/payload handling. An unknown
# partial layout must never be interpreted as an empty card or formatted.
load_provision_state
if [ "$PROVISION_ACTIVE" = 1 ]; then
    echo "Resuming $PROVISION_MODE transaction"
    setScreenUpdating
    setLedUpdating
    resume_provisioning
    if [ "$PROVISION_MODE" != new ]; then reboot_after_maintenance; fi
    setLedDone
elif [ "${FORCE_FACTORY_RESET:-0}" = 1 ]; then
    factory_reset
elif ! all_data_partitions_exist; then
    for existing_part in 2 3 4; do
        partition_exists "$existing_part" && fatal "Unrecorded partial layout; inspect disk before repair"
    done
    setScreenUpdating
    setLedUpdating
    begin_provisioning new
    resume_provisioning
    setLedDone
fi

# Established filesystems are never silently reformatted during normal boot.
if [ "${FORCE_FACTORY_RESET:-0}" = 1 ]; then factory_reset; fi
filesystem_matches 4 ext3 LOG || fatal "Invalid LOG filesystem"
checkLog
mkdir -p /mnt/log || fatal "Cannot create LOG mountpoint"
mount "$(part_dev 4)" /mnt/log || fatal "Cannot mount LOG"
mkdir -p "$UPDATE_DIR" || fatal "Cannot create update directory"

if [ -e "$UPDATE_DIR/UPDATE" ]; then
    # UPDATE survives all installation failures and is handled before generic
    # LATEST reseeding, so interrupted updates can retry the original archive.
    rm -f "$UPDATE_DIR/READY" || fatal "Cannot clear update notification"
    setScreenUpdating
    setLedUpdating
    if ! select_update_archive || ! install_update; then
        record_update_failure
        fatal "Update failed; request retained: $UPDATE_ERROR"
    fi
    if [ -e "$UPDATE_DIR/RESETSETTINGS" ]; then
        # LOG contains the update request. Record the verified settings reset
        # on GOLDEN before deleting LOG; this state survives a reset failure.
        begin_provisioning settings
        umount /mnt/log || fatal "Cannot release LOG before settings reset"
        resume_provisioning
    else
        if ! finish_update; then
            record_update_failure
            fatal "Update completion failed: $UPDATE_ERROR"
        fi
        if ! umount /mnt/log; then
            touch "$UPDATE_DIR/UPDATE" || fatal "Cannot retain update request after LOG unmount failure"
            UPDATE_ERROR="Cannot unmount completed update log"
            record_update_failure
            fatal "$UPDATE_ERROR"
        fi
    fi
    reboot_after_maintenance
elif [ -e "$UPDATE_DIR/FACTORYRESET" ]; then
    umount /mnt/log || fatal "Cannot release LOG before factory reset"
    factory_reset
elif [ -e "$UPDATE_DIR/RESETSETTINGS" ]; then
    setScreenUpdating
    setLedUpdating
    begin_provisioning settings
    umount /mnt/log || fatal "Cannot release LOG before settings reset"
    resume_provisioning
    reboot_after_maintenance
else
    umount /mnt/log || fatal "Cannot release LOG"
    filesystem_matches 2 vfat LATEST || fatal "Invalid LATEST filesystem; inspect before repair"
    if ! latest_has_boot_payload; then seed_latest_from_golden; fi
fi
mount_and_boot
