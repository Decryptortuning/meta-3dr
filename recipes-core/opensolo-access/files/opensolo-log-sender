#!/bin/sh
set -eu
PID=/run/opensolo-log-sender.pid
case "${1:-}" in
    start)
        start-stop-daemon --start --quiet --background --make-pidfile --pidfile "$PID" \
            --startas /usr/bin/dataFlashMAVLink-to-artoo.py
        ;;
    stop)
        start-stop-daemon --stop --quiet --oknodo --pidfile "$PID"
        rm -f "$PID"
        ;;
    restart) "$0" stop; "$0" start ;;
    *) echo "usage: $0 start|stop|restart" >&2; exit 2 ;;
esac
