#!/bin/sh
# OpenSolo: one network-time owner in standby/maintenance; GPS retains flight.
set -eu
PATH=/sbin:/bin:/usr/sbin:/usr/bin
DAEMON=/usr/sbin/chronyd
PIDFILE=/run/chrony/chronyd.pid
CONF=/etc/chrony.conf
level=${RUNLEVEL:-$(runlevel 2>/dev/null | awk '{print $2}')}
case "${1:-}" in
 start)
    # Also guard a manual restart while paired/flight services own time.
    case "$level" in S|3|5) ;; *) exit 0 ;; esac
    [ -x "$DAEMON" ] || exit 1
    if [ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then exit 0; fi
    install -d -m 0750 -o chronyd -g chronyd /run/chrony
    touch /run/opensolo-network-time.active
    if [ "$level" = S ] && mkdir /run/opensolo-time-bootstrap 2>/dev/null; then
        # A missing network/server never blocks boot indefinitely. The saved
        # image/persistent time floor remains in place on timeout/failure.
        if ip -4 route show default | grep -q '^default' || ip -6 route show default | grep -q '^default'; then
            "$DAEMON" -q -t 10 -f "$CONF" || logger -t opensolo-time "boot time sync unavailable; retained time floor"
        else
            logger -t opensolo-time "offline boot: retained time floor; standby client will retry"
        fi
    fi
    # -R also disables any positive-limit startup-step setting on restart.
    start-stop-daemon -S -q -o -p "$PIDFILE" -x "$DAEMON" -- -R -f "$CONF"
    ;;
 stop)
    if [ -s "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE")
        start-stop-daemon -K -q -p "$PIDFILE" -x "$DAEMON" || true
        count=0
        while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 5 ]; do
            sleep 1; count=$((count + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            logger -t opensolo-time "chronyd did not stop; flight time ownership not established"
            exit 1
        fi
        rm -f "$PIDFILE"
    fi
    rm -f /run/opensolo-network-time.active
    ;;
 restart) "$0" stop; "$0" start ;;
 *) echo "Usage: chronyd {start|stop|restart}" >&2; exit 2 ;;
esac
