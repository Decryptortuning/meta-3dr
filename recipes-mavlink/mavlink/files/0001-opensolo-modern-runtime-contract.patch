+class MAVLink_char_array_field:
+    """Text API with exact raw-wire backing, including embedded NUL tails."""
+    def __init__(self, name):
+        self.name = name
+        self.raw = "_" + name + "_raw"
+
+    def __get__(self, instance, owner):
+        if instance is None:
+            return owner.msgname if self.name == "name" else self
+        return getattr(instance, self.raw).split(b"\\x00", 1)[0].decode("utf-8", "surrogateescape")
+
+    def __set__(self, instance, value):
+        if isinstance(value, str):
+            value = value.encode("utf-8", "surrogateescape")
+        elif not isinstance(value, (bytes, bytearray)):
+            raise TypeError("MAVLink char field requires text or bytes")
+        setattr(instance, self.raw, bytes(value))
 
 
