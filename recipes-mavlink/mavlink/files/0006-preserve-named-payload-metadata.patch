Subject: [PATCH] generator: distinguish message metadata from named payloads

Upstream-Status: Inappropriate [Solo legacy Python3 text-property compatibility]

The text property for a payload called name must not replace the legacy class
message name consumed by constructors and dispatch. Wrap only those properties
so class access returns the fixed message name and instance access delegates to
the existing raw-byte-backed getter/setter. Preserve public names and wire data.

--- a/generator/mavgen_python.py
+++ b/generator/mavgen_python.py
@@ -52,6 +52,22 @@
 MAVLINK_TYPE_INT64_T  = 8
 MAVLINK_TYPE_FLOAT    = 9
 MAVLINK_TYPE_DOUBLE   = 10
+
+
+
+class _MAVLinkMessageNameProperty(object):
+    # A payload named "name" shares the legacy class message-name attribute.
+    def __init__(self, message_name, payload_property):
+        self.message_name = message_name
+        self.payload_property = payload_property
+
+    def __get__(self, instance, owner=None):
+        if instance is None:
+            return self.message_name
+        return self.payload_property.__get__(instance, owner)
+
+    def __set__(self, instance, value):
+        self.payload_property.__set__(instance, value)
 
 
 class MAVLink_header(object):
@@ -280,6 +296,8 @@
                         raise TypeError('MAVLink char array requires text or bytes')
                 self._{name}_raw = bytes(value)
 """.format(name=field.name))
+                        if field.name == "name":
+                                outf.write("        name = _MAVLinkMessageNameProperty({0!r}, name)\n".format(m.name.upper()))
 
 
 def native_mavfmt(field):
